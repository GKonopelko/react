#!/bin/sh
. "$(dirname "$0")/_/husky.sh"

echo "🚀 Running pre-push checks..."

echo "🔍 Running tests..."
if ! npm run test -- --run; then
  echo "❌ Tests failed!"
  exit 1
fi

echo "📊 Checking coverage..."
if ! npm run test:coverage -- --run; then
  echo "❌ Coverage check failed!"
  exit 1
fi

echo "✅ All checks passed!"